}

@article{yuControllingTimeVaryingConfounding2026,
  title = {Controlling for {{Time-Varying Confounding}} in the {{Longitudinal Fixed-Effects Model}}: {{A Latent Variable Approach}}},
  shorttitle = {Controlling for {{Time-Varying Confounding}} in the {{Longitudinal Fixed-Effects Model}}},
  author = {Yu, Baeksan and Finkel, Steven},
